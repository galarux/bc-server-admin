<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- Demo configuration generated by bc-server-admin -Demo. Values are fictitious. -->
  <!--
    Database connection protocol.
    Valid options: Default, NamedPipes, Sockets
  -->
  <add key="NetworkProtocol" value="Default" />
  <!-- SQL Server that hosts the database. -->
  <add key="DatabaseServer" value="{{DBSERVER}}" />
  <!-- Named SQL Server instance (empty for the default instance). -->
  <add key="DatabaseInstance" value="{{DBINSTANCE}}" />
  <!-- Name of the Business Central database. -->
  <add key="DatabaseName" value="{{DBNAME}}" />
  <!-- SQL login used when SQL authentication is configured. -->
  <add key="DatabaseUserName" value="{{DBUSER}}" />
  <!-- Encrypted SQL password. Change it with the database credentials dialog. -->
  <add key="ProtectedDatabasePassword" value="{{DBPASSWORD}}" />
  <!-- Request encrypted SQL connections. -->
  <add key="EnableSqlConnectionEncryption" value="true" />
  <!-- Trust the SQL Server certificate without validating the chain. -->
  <add key="TrustSQLServerCertificate" value="true" />
  <!-- Name of this server instance. -->
  <add key="ServerInstance" value="{{INSTANCE}}" />
  <!-- Collect the last SQL statements for the debugger. -->
  <add key="EnableSqlInformationDebugger" value="true" />
  <!-- Number of SQL statements shown in the debugger. -->
  <add key="AmountOfSqlStatementsInDebugger" value="10" />
  <!-- Show long running SQL statements in the debugger. -->
  <add key="EnableLongRunningSqlStatementsInDebugger" value="true" />
  <!-- Threshold in milliseconds for long running SQL statements in the debugger. -->
  <add key="LongRunningSqlStatementsInDebuggerThreshold" value="500" />
  <!-- Enables the developer endpoint used by Visual Studio Code. -->
  <add key="DeveloperServicesEnabled" value="true" />
  <!-- Port of the developer endpoint. -->
  <add key="DeveloperServicesPort" value="{{PORT_DEV}}" />
  <!-- Use HTTPS for the developer endpoint. -->
  <add key="DeveloperServicesSSLEnabled" value="false" />
  <!-- Maximum size in bytes of a request to the developer endpoint. -->
  <add key="DeveloperServicesMaxRequestLength" value="419430400" />
  <!-- Enables the snapshot debugger. -->
  <add key="SnapshotDebuggerEnabled" value="false" />
  <!-- Port of the snapshot debugger endpoint. -->
  <add key="SnapshotDebuggerServicesPort" value="{{PORT_SNAP}}" />
  <!-- Use HTTPS for the snapshot debugger endpoint. -->
  <add key="SnapshotDebuggerServicesSSLEnabled" value="false" />
  <!-- Allowed target level when publishing extensions. -->
  <add key="ExtensionAllowedTargetLevel" value="Internal" />
  <!-- Allows debugging sessions on this instance. -->
  <add key="DebuggingAllowed" value="true" />
  <!-- Allows test automation (test codeunits, test pages). -->
  <add key="TestAutomationEnabled" value="true" />
  <!-- Compile extensions using several threads. -->
  <add key="EnableMultithreadedCompilation" value="true" />
  <!-- Load symbols when the server starts. -->
  <add key="EnableSymbolLoadingAtServerStartup" value="false" />
  <!-- Enables the management endpoint used by the administration cmdlets. -->
  <add key="ManagementServicesEnabled" value="true" />
  <!-- Port of the management endpoint. -->
  <add key="ManagementServicesPort" value="{{PORT_MGMT}}" />
  <!-- Idle timeout for management clients. -->
  <add key="ManagementServicesIdleClientTimeout" value="10:00:00" />
  <!-- Enables the management API endpoint. -->
  <add key="ManagementApiServicesEnabled" value="true" />
  <!-- Port of the management API endpoint. -->
  <add key="ManagementApiServicesPort" value="{{PORT_MGMTAPI}}" />
  <!-- Use HTTPS for the management API endpoint. -->
  <add key="ManagementApiServicesSSLEnabled" value="false" />
  <!-- Enables client services (web client connections). -->
  <add key="ClientServicesEnabled" value="true" />
  <!-- Port of the client services endpoint. -->
  <add key="ClientServicesPort" value="{{PORT_CLIENT}}" />
  <!--
    Credential type used to authenticate users.
    Possible values: Windows, UserName, NavUserPassword, AccessControlService
  -->
  <add key="ClientServicesCredentialType" value="{{CREDTYPE}}" />
  <!--
    Protection level of the client services channel.
    Valid options: EncryptAndSign, Sign, None
  -->
  <add key="ClientServicesProtectionLevel" value="EncryptAndSign" />
  <!-- Maximum number of concurrent client connections. -->
  <add key="ClientServicesMaxConcurrentConnections" value="4000" />
  <!-- Maximum upload size in MB. -->
  <add key="ClientServicesMaxUploadSize" value="350" />
  <!-- Idle timeout for client connections. -->
  <add key="ClientServicesIdleClientTimeout" value="MaxValue" />
  <!-- Operation timeout for client requests. -->
  <add key="ClientServicesOperationTimeout" value="MaxValue" />
  <!-- Use HTTPS for client services. -->
  <add key="ClientServicesSSLEnabled" value="false" />
  <!-- File extensions that users cannot upload. -->
  <add key="ClientServicesProhibitedFileTypes" value="ade;adp;bat;cmd;com;exe;js;msi;ps1;reg;vbs" />
  <!-- Allow, warn or block clients with a different build number. -->
  <add key="ClientBuildRestriction" value="WarnClient" />
  <!-- Thumbprint of the certificate used by the service endpoints. -->
  <add key="ServicesCertificateThumbprint" value="{{THUMBPRINT}}" />
  <!-- Validate the certificate of the service endpoints. -->
  <add key="ServicesCertificateValidationEnabled" value="true" />
  <!-- Use NTLM for SOAP and OData when the credential type is Windows. -->
  <add key="ServicesUseNTLMAuthentication" value="true" />
  <!-- Enables SOAP web services. -->
  <add key="SOAPServicesEnabled" value="true" />
  <!-- Port of the SOAP endpoint. -->
  <add key="SOAPServicesPort" value="{{PORT_SOAP}}" />
  <!-- Use HTTPS for SOAP. -->
  <add key="SOAPServicesSSLEnabled" value="false" />
  <!-- Maximum SOAP message size in KB. -->
  <add key="SOAPServicesMaxMsgSize" value="65536" />
  <!-- SOAP operation timeout. -->
  <add key="SOAPServicesOperationTimeout" value="00:10:00" />
  <!-- Public base URL used in SOAP links. -->
  <add key="PublicSOAPBaseUrl" value="" />
  <!-- Enables OData web services. -->
  <add key="ODataServicesEnabled" value="true" />
  <!-- Port of the OData and API endpoint. -->
  <add key="ODataServicesPort" value="{{PORT_ODATA}}" />
  <!-- Use HTTPS for OData. -->
  <add key="ODataServicesSSLEnabled" value="false" />
  <!-- Enables the OData V4 endpoint. -->
  <add key="ODataServicesV4EndpointEnabled" value="true" />
  <!-- Maximum page size for OData responses. -->
  <add key="ODataServicesMaxPageSize" value="20000" />
  <!-- OData operation timeout. -->
  <add key="ODataServicesOperationTimeout" value="00:08:00" />
  <!-- Public base URL used in OData links. -->
  <add key="PublicODataBaseUrl" value="" />
  <!-- Enables API pages and queries. -->
  <add key="ApiServicesEnabled" value="true" />
  <!-- Enables webhook subscriptions for APIs. -->
  <add key="ApiSubscriptionsEnabled" value="true" />
  <!-- Maximum number of webhook subscriptions. -->
  <add key="ApiSubscriptionMaxNumberOfSubscriptions" value="200" />
  <!-- Enables the NAS startup codeunit. -->
  <add key="NASServicesStartupCodeunit" value="" />
  <!-- Method called on the NAS startup codeunit. -->
  <add key="NASServicesStartupMethod" value="" />
  <!-- Argument passed to the NAS startup codeunit. -->
  <add key="NASServicesStartupArgument" value="" />
  <!-- Run NAS sessions with administrator rights. -->
  <add key="NASServicesRunWithAdminRights" value="false" />
  <!-- Microsoft Entra application (client) ID. -->
  <add key="AzureActiveDirectoryClientId" value="" />
  <!-- Microsoft Entra client secret. -->
  <add key="AzureActiveDirectoryClientSecret" value="{{AADSECRET}}" />
  <!-- App ID URI registered in Microsoft Entra ID. -->
  <add key="AppIdUri" value="" />
  <!-- Allowed token audiences. -->
  <add key="ValidAudiences" value="" />
  <!-- WS-Federation login endpoint. -->
  <add key="WSFederationLoginEndpoint" value="" />
  <!-- Encryption key provider. -->
  <add key="EncryptionProvider" value="LocalKeyFile" />
  <!-- Azure Key Vault client ID. -->
  <add key="AzureKeyVaultClientId" value="00000000-0000-0000-0000-000000000000" />
  <!-- Security protocol for outgoing connections. -->
  <add key="SecurityProtocol" value="SystemDefault" />
  <!-- Allow AL code to access files on the server. -->
  <add key="EnableALServerFileAccess" value="true" />
  <!-- Enables data export/import between companies. -->
  <add key="EnableDataExportImport" value="true" />
  <!-- Enables the job queue task scheduler. -->
  <add key="EnableTaskScheduler" value="true" />
  <!-- Maximum number of tasks running at the same time. -->
  <add key="TaskSchedulerMaximumConcurrentRunningTasks" value="5" />
  <!-- Start time for system tasks. -->
  <add key="TaskSchedulerSystemTaskStartTime" value="00:00:00" />
  <!-- End time for system tasks. -->
  <add key="TaskSchedulerSystemTaskEndTime" value="23:59:59" />
  <!-- Default timeout of task scheduler sessions. -->
  <add key="DefaultTaskSchedulerSessionTimeout" value="12:00:00" />
  <!-- Default report timeout. -->
  <add key="ReportDefaultTimeout" value="06:00:00" />
  <!-- Default maximum number of rows in a report. -->
  <add key="ReportDefaultMaxRows" value="500000" />
  <!-- Maximum number of rows in a report. -->
  <add key="ReportMaxRows" value="10000000" />
  <!-- Embed fonts in PDF reports. -->
  <add key="ReportPDFFontEmbedding" value="true" />
  <!-- Allow saving RDLC reports to Excel. -->
  <add key="EnableSaveToExcelForRdlcReports" value="true" />
  <!-- Printers that cannot be used from reports. -->
  <add key="ProhibitedReportServerPrinters" value="[&quot;Microsoft Print to PDF&quot;,&quot;Microsoft XPS Document Writer&quot;]" />
  <!-- Maximum concurrent background sessions. -->
  <add key="BackgroundSessionsMaxConcurrent" value="10" />
  <!-- Maximum queued background sessions. -->
  <add key="BackgroundSessionsMaxQueued" value="100" />
  <!-- Maximum concurrent child sessions. -->
  <add key="ChildSessionsMaxConcurrency" value="5" />
  <!-- Default timeout of page background tasks. -->
  <add key="PageBackgroundTaskDefaultTimeout" value="00:02:00" />
  <!-- Maximum timeout for HttpClient calls from AL. -->
  <add key="NavHttpClientMaxTimeout" value="00:05:00" />
  <!-- Maximum number of rows returned by queries. -->
  <add key="QueryMaxRows" value="MaxValue" />
  <!-- Search timeout. -->
  <add key="SearchTimeout" value="00:00:30" />
  <!-- Application Insights connection string for telemetry. -->
  <add key="ApplicationInsightsConnectionString" value="{{AICONN}}" />
  <!--
    Lowest severity of telemetry events written to the event log.
    You can set the value to Critical, Error, Warning, Normal, Verbose or Off.
  -->
  <add key="TraceLevel" value="Normal" />
  <!-- Lowest severity for external events. -->
  <add key="ExternalTraceLevel" value="Error" />
  <!-- Threshold in milliseconds for long running SQL telemetry. -->
  <add key="SqlLongRunningThreshold" value="750" />
  <!-- Allow SQL tracing from the client. -->
  <add key="SqlTracingAllowed" value="true" />
  <!-- Enables the sampling profiler. -->
  <add key="SamplingProfilingEnabled" value="true" />
  <!-- Timeout of SQL commands. -->
  <add key="SqlCommandTimeout" value="00:30:00" />
  <!-- Timeout when opening SQL connections. -->
  <add key="SqlConnectionTimeout" value="00:01:30" />
  <!-- Batch size for bulk inserts. -->
  <add key="SqlBulkImportBatchSize" value="448" />
  <!-- Buffer inserts to reduce SQL round trips. -->
  <add key="BufferedInsertEnabled" value="true" />
  <!-- Load only the fields that are used (partial records). -->
  <add key="EnablePartialRecords" value="true" />
  <!-- Default client type used for GetUrl. -->
  <add key="DefaultClient" value="Web" />
  <!-- Public URL of the web client. -->
  <add key="PublicWebBaseUrl" value="{{WEBURL}}" />
  <!-- Default company for web services. -->
  <add key="ServicesDefaultCompany" value="{{COMPANY}}" />
  <!-- Time zone used by web services. -->
  <add key="ServicesDefaultTimeZone" value="UTC" />
  <!-- Language used by web services. -->
  <add key="ServicesLanguage" value="en-US" />
  <!-- Runs the instance in multitenant mode. -->
  <add key="Multitenant" value="{{MULTITENANT}}" />
  <!-- Data cache size (power of two, in MB). -->
  <add key="DataCacheSize" value="9" />
  <!-- Maximum concurrent calls. -->
  <add key="MaxConcurrentCalls" value="1000" />
  <!--
    How UI elements are removed.
    Possible values:
        None
        LicenseFile
        LicenseFileAndUserPermissions
  -->
  <add key="UIElementRemovalOption" value="LicenseFileAndUserPermissions" />
  <!-- Size of the XML metadata cache. -->
  <add key="XmlMetadataCacheSize" value="500" />
</appSettings>
