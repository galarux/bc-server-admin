{
  "$comment": "Shared by the web UI and the PowerShell exporter. Categories are evaluated in array order (first match wins, case-insensitive); 'order' is the display order. Suggestions feed the value editor as hints, free text is still allowed.",
  "categories": [
    {
      "id": "entra",
      "order": 10,
      "label": { "en": "Microsoft Entra ID", "es": "Microsoft Entra ID" },
      "patterns": ["^(AzureActiveDirectory|ADOpenIdMetadataLocation|AppIdUri|ValidAudiences|WSFederation|ExcelAddIn|ExchangeAuthentication|TokenSigningCertificate|DisableTokenSigningCertificateValidation|ExtendedSecurityTokenLifetime|ClientServicesTokenSigningKey|ClientServicesFederation)"]
    },
    {
      "id": "security",
      "order": 11,
      "label": { "en": "Security & encryption", "es": "Seguridad y cifrado" },
      "patterns": ["^(AzureKeyVault|EncryptionProvider|SecurityProtocol|EnableALServerFileAccess|EnableMalwareScanning|EnableDataExportImport|EnableExclusiveApplicationPackageRole|UsePermissionSetsFromExtensions|LockoutPolicy)"]
    },
    {
      "id": "telemetry",
      "order": 15,
      "label": { "en": "Telemetry & diagnostics", "es": "Telemetría y diagnóstico" },
      "patterns": ["^ApplicationInsights", "ForApplicationInsights$", "^(TraceLevel|ExternalTraceLevel|EnableFullALFunctionTracing|ALFunctionTimingEnabled|ALLongRunning|SamplingProfilingEnabled|EnableApplicationChannelLog|SqlTracingAllowed|EnableDeadlockMonitoring|EnableLockTimeoutMonitoring|SqlLongRunningThreshold|ExternalEvents)"]
    },
    {
      "id": "development",
